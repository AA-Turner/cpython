foreach dir : lib_subdirs
  install_subdir(dir,
    install_dir: get_option('libdir') / 'python@0@'.format(py_release),
    install_tag: 'runtime',
    strip_directory: false,
    exclude_directories: '__pycache__'
  )
endforeach

foreach file : lib_files
  install_data(file,
    install_dir: get_option('libdir') / 'python@0@'.format(py_release),
    install_tag: 'runtime',
    preserve_path: true
  )
endforeach

